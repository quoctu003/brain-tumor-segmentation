# Paths are relative to BrainTumorAI/, even when starting from backend/.
DATABASE_URL=sqlite:///storage/braintumor.db
STORAGE_DIR=storage
MODEL_PATH=models/unet_v2_best.pth
MODEL_METADATA_PATH=models/model_metadata.json
DEVICE=auto
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=128
MAX_VOXELS=12000000
MAX_NIFTI_MB=128
MAX_PENDING_JOBS=4
DEMO_DIR=demo
FRONTEND_DIST=frontend/dist
# Optional Unicode TTF font for PDF reports; Arial/DejaVu are detected automatically.
# REPORT_FONT_PATH=C:/Windows/Fonts/arial.ttf
